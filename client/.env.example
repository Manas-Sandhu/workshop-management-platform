# Backend API base URL — only needed for local development.
# In production on Vercel the vercel.json rewrite proxies /api/* to Render,
# so this variable should be UNSET (the app defaults to "/api").
# For local dev with the Vite proxy, this can also be unset — the proxy
# in vite.config.js handles /api/* → http://localhost:5001/api/v1/*.
VITE_API_BASE_URL=

