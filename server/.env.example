PORT=5001
NODE_ENV=development

# Neon pooled connection — used by the app at runtime (Prisma PgAdapter)
DATABASE_URL=

# Neon direct (non-pooled) connection — used by prisma migrate deploy
DIRECT_URL=

SESSION_SECRET=

# Full URL of the deployed frontend, e.g. https://your-app.vercel.app
CLIENT_URL=

# Resend email service
RESEND_API_KEY=
EMAIL_FROM=

# Admin seed (only needed when running npm run db:seed-admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
